{
  "installCommand": "pip install --break-system-packages -r requirements.txt && npm install",
  "buildCommand": "npx tailwindcss -i frontend/assets/css/tailwind-src.css -o frontend/assets/css/tailwind.min.css --minify && mkdir -p public && cp -r frontend/* public/",
  "trailingSlash": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/confirm", "destination": "/api?x-path=/api/book/confirm" },
    { "source": "/confirm/", "destination": "/api?x-path=/api/book/confirm" },
    { "source": "/decline", "destination": "/api?x-path=/api/book/decline" },
    { "source": "/decline/", "destination": "/api?x-path=/api/book/decline" }
  ]
}
